package oops;

class Pen
{
	//data member / variables
	static String color = "red";
	int price = 50;
	String company = "Cello";
	
	
	//function member / methods
	 void toWrite()
	{
		System.out.println(price+" "+color+" "+company);
	}
}

public class O001_ClassDemo {
	public static void main(String[] args) {
		
		Pen.color="Green";
		
		Pen p1 = new Pen();
		p1.toWrite();
		
		
		Pen p2 = new Pen();
		p2.toWrite();
		
		
		
	}
}
