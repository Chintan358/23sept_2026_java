package operators;

public class O001_Unary {

		public static void main(String[] args) {
			
			
			// ++pre,--pre,post++,post--
			
			int a = 10;
			int b = ++a - ++a + --a - a-- + ++a;
			      //  11  - 12  +  11 - 11  + 11
			      
			System.out.println(a); //11
			System.out.println(b); //12
			
		}
}
